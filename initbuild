# Determine run state
if [ "$BUILD_STAMP" == "" ]; then
	export DO_RESET=Y
elif [ "$1" == "reset" ]; then
	export DO_RESET=Y
else
	export DO_RESET=N
fi

# Fixed: Consolidated redundant directory configuration logic into a single block
if [ "$DO_RESET" == "Y" ]
then
	#export BUILD_STAMP=`date '+%Y-%m-%d-%Hh%M'`
	export BUILD_STAMP="alpha13-ebf-202610172100"

	export TMPDIR=/opt/${USER}
	if [ ! -d $TMPDIR ]; then
		sudo mkdir $TMPDIR
		sudo chown $USER:$USER $TMPDIR
		sudo chmod 755 $TMPDIR
	fi

	# Fixed: Added LC_ALL=C for cross-platform OS compatibility (Linux/macOS)
	RANDOM_STR=$(LC_ALL=C tr -dc A-Za-z0-9 </dev/urandom | head -c 16)

	export TMP_DIR=${TMPDIR}/${RANDOM_STR}
	if [ ! -d $TMP_DIR ]; then
		mkdir $TMP_DIR
	fi
fi

