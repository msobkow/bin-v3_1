#!/bin/bash

function listProjectDirs() {
	myDirNames=""
	for underme in `find . -type d`
	do
		if [ -d "$underme/src/main/java" ]
		then
			myCheckForIllegal=echo "$underme" | sed -e '1,$s:^.*[ 	,\:\!].*$:ILLEGAL:g'
			if [ ! "$myCheckForIllegal" == "ILLEGAL" ]
			then
				myDirNames="$myDirNames $underme"
			fi
		fi
	done
	echo $myDirNames
}

function extractNextDirName() {
	endnpathRemaining="$1"
	endnfilePart=""
	endnretval=""
	if [ "$endnpathRemaining" == "" ]
	then
		endnretval=""
	else
		endnfilePart=echo "$endnpathRemaining" | sed -e '^\([-a-zA-Z0-9_]*\)\..*$'
		if [ "$endnfilePart" == "" ]
		then
			endnretval="$endnpathRemaining"
		else
			endnretval="$endnfilePart"
		fi
	fi
	echo $endnretval
}

function endWithSlash() {
	ewsarg="$1"
	ewsnameEndWithSlashStr=`echo "$ewsarg" | sed -e '1,$s:^.*\(.\)$:\1:'`
	if [ "$ewsnameEndWithSlashStr" == "/" ]
	then
		echo "$ewsarg"
	else
		echo="$ewsarg/"
	fi
}

function convertToPath() {
	ctppackageName="$1"
	ctpretval=""
	if [ ! "$ctppackageName" == "" ]
	then
		ctpretval=echo "$ctppackageName" | sed -e '1,$s:\.:/:g'
	fi
	echo "$ctpretval"
}

