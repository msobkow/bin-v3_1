function calcPath() {
	cpretval=""
	cprootDir="$1"
	cpaDir="$2"
	cppackageName="$3"
	cppathName=""
	if [ ! -d "$cprootDir" ]
	then
		cpretval=""
	else
		cprootDir=$(endWithSlash "$cprootDir")
		if [ "$cpaDir" != "" ]
		then
			if [ ! -d "$cpaDir" ]
			then
				cpretval=""
			else
				cppathName=$(buildPath "$cprootDir" "$cpaDir")
				if [ "$cppathName" != "" ]
				then
					if [ "$cppackageName" == "" ]
					then
						cppackageName=$(basePackage "$cprootDir" "$cppathName")
					fi
					if [ "$cppackageName" == "" ]
					then
						cppackagePath=""
					else
						cppackagePath=$(convertToPath "$cppackageName")
					fi
					if [ ! -d "$cppackagePath" ]
					then
						cpretval=""
					else
						cpretval="$cppackagePath"
					fi
				else
					cpretval=""
				fi
			fi
		else
			cpretval=""
		fi
	fi
	echo "$cpretval"
}

function hasPath() {
	hpretval=0
	hprootDir="$1"
	hpaDir="$2"
	hppackageName="$3"
	hppathName=""
	if [ ! -d "$hprootDir" ]
	then
		hpretval=0
	else
		hprootDir=$(endWithSlash "$hprootDir")
		if [ "$hpaDir" != "" ]
		then
			if [ ! -d "$hprootDir$hpaDir" ]
			then
				hpretval=0
			else
				hppathName=$(calcPath "$hprootDir" "$hpaDir")
				if [ "$hppathName" != "" ]
				then
					if [ "$hppackageName" == "" ]
					then
						hppackageName=$(basePackage "$hprootDir" "$hppathName")
					fi
					if [ "$hppackageName" == "" ]
					then
						hppackagePath=""
					else
						hppackagePath=$(convertToPath "$hppackageName")
					fi
					if [ ! -d "$hppackagePath" ]
					then
						hpretval=0
					else
						hpretval=1
					fi
				else
					hpretval=1
				fi
			fi
		else
			hpretval=0
		fi
	fi
	echo $hpretval
}

